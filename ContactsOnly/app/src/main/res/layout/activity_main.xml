<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/BodyText" android:text="@string/eyebrow" android:textSize="12sp"
            android:letterSpacing="0.15" android:textColor="@color/accent" android:layout_marginTop="12dp" />
        <TextView style="@style/SectionTitle" android:text="@string/app_name" android:textSize="34sp"
            android:layout_marginTop="8dp" android:accessibilityHeading="true" />
        <TextView style="@style/BodyText" android:text="@string/subtitle" android:layout_marginTop="8dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/status_card" android:layout_marginTop="24dp">
            <TextView android:id="@+id/status_title" style="@style/SectionTitle" android:text="@string/status_setup" />
            <TextView android:id="@+id/status_detail" style="@style/BodyText" android:layout_marginTop="8dp"
                android:text="@string/detail_setup" />
            <Switch android:id="@+id/blocking_switch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="64dp" android:layout_marginTop="12dp"
                android:text="@string/blocking_switch" android:textSize="17sp" android:switchPadding="12dp" />
            <Button android:id="@+id/setup_button" style="@style/ActionButton" android:text="@string/setup_button" />
            <Button android:id="@+id/pause_button" style="@style/ActionButton" android:text="@string/pause" />
        </LinearLayout>

        <Button android:id="@+id/test_button" style="@style/ActionButton" android:layout_marginTop="12dp"
            android:text="@string/test_button" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card" android:layout_marginTop="16dp">
            <TextView style="@style/SectionTitle" android:text="@string/history_title" android:accessibilityHeading="true" />
            <TextView style="@style/BodyText" android:text="@string/history_note" android:layout_marginTop="8dp" />
            <LinearLayout android:id="@+id/history_list" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" />
            <Button android:id="@+id/clear_button" style="@style/ActionButton" android:text="@string/clear_history" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card" android:layout_marginTop="16dp">
            <TextView style="@style/SectionTitle" android:text="@string/about_title" android:accessibilityHeading="true" />
            <TextView style="@style/BodyText" android:text="@string/about_body" android:layout_marginTop="12dp" />
            <TextView style="@style/SectionTitle" android:text="@string/privacy_title" android:layout_marginTop="24dp"
                android:accessibilityHeading="true" />
            <TextView style="@style/BodyText" android:text="@string/privacy_body" android:layout_marginTop="8dp" />
        </LinearLayout>
        <TextView android:id="@+id/diagnostics" style="@style/BodyText" android:textSize="12sp"
            android:layout_marginTop="20dp" android:layout_marginBottom="16dp" android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
